# Diabetes Risk Predictor — Frontend Environment Variables
# Centralized API Base URL for future Node.js / Express backend integration
VITE_API_BASE_URL=http://localhost:5000/api

# Enable Demonstration Mode (true: provides fallback mock data if backend is offline)
VITE_ENABLE_DEMO_MODE=true

# Application Metadata
VITE_APP_NAME="Diabetes Risk Predictor"
